# Copiá este archivo como ".env" y completá los valores. NUNCA subas ".env" a Git.

NODE_ENV=development
PORT=4000

# Conexión a PostgreSQL (ajustá usuario, contraseña y nombre de la base)
DATABASE_URL="postgresql://dancetrack:dancetrack@localhost:5432/dancetrack?schema=public"

# Base SEPARADA solo para tests (los tests VACÍAN sus tablas). Debe ser distinta de DATABASE_URL.
TEST_DATABASE_URL="postgresql://dancetrack:dancetrack@localhost:5432/dancetrack_test?schema=public"

# Secreto para firmar la cookie de sesión (mínimo 32 caracteres, aleatorio).
# Generá uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-32-o-mas-caracteres

# Único origen del frontend autorizado por CORS
CLIENT_ORIGIN=http://localhost:5173

# Zona horaria usada para decidir "hoy" y calcular semanas
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Contraseña de las cuentas de demostración creadas por el seed (solo desarrollo)
DEMO_PASSWORD=Demo12345
